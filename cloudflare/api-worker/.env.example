# ============================================================================
# LADIESGO API — variáveis de ambiente (Fase 1)
# Copie para .env e preencha os valores.
# Nunca commitar .env com segredos reais.
# ============================================================================

# JWT — gerar um segredo aleatório de 256 bits (mínimo 32 caracteres)
# Exemplo: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
JWT_SECRET="coloque-aqui-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Rate limiting (Fase 1)
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"

# Debug (opcional)
DEBUG_KEY="devdebug"

# D1 (gerido pelo wrangler, não precisa aqui)
# DATABASE_URL="postgresql://..."
