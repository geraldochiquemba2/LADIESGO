# LadiesGo selfhost — EXEMPLO. Copiar para `.env` e preencher (NUNCA commitar o .env real).
#   cp .env.example .env
#   nano .env   # ou notepad no Windows antes de enviar ao VPS

# Domínio público dos mapas (DONO cria DNS — ver README §4). Sem https://, só o host.
DOMAIN=maps.example.com
# Email p/ avisos de expiração do Let's Encrypt (DONO preenche).
ACME_EMAIL=devops@example.com

# Postgres do APP (utilizador normal; postgres cria superuser à parte se precisar).
POSTGRES_USER=ladiesgo
POSTGRES_PASSWORD=TROCA-ISTO-POR-32-CARACTERES-ALEATORIOS
POSTGRES_DB=ladiesgo

# Backups (caminho DENTRO do VPS; script backup-postgres.sh usa estes).
BACKUP_DIR=/opt/ladiesgo/backups
RETENTION_DAYS=7
