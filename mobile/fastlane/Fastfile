default_platform(:ios)

platform :ios do
  desc "Gera cert + perfil, compila o IPA com Xcode e envia para o TestFlight (sem EAS)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    cert(api_key: api_key, development: false)

    sigh(
      api_key: api_key,
      app_identifier: "com.ladiesgo.app",
      cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID],
      force: true
    )

    build_ios_app(
      workspace: ENV.fetch("WORKSPACE"),
      scheme: ENV.fetch("SCHEME"),
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build",
      output_name: "ladiesgo.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      export_options: {
        provisioningProfiles: {
          "com.ladiesgo.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
